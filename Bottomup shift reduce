
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 100

char input[MAX];
char stack[MAX];
int input_pos = 0;
int stack_top = -1;

void display(const char *action)
{
    stack[stack_top + 1] = '\0';
    printf("\n$%s\t\t%s$\t\t%s", stack, input + input_pos, action);
}

int reduce(void)
{
    /* E -> a | b */
    if (stack_top >= 0 &&
        (stack[stack_top] == 'a' || stack[stack_top] == 'b'))
    {
        char symbol = stack[stack_top];
        stack[stack_top] = 'E';
        display(symbol == 'a' ? "E -> a" : "E -> b");
        return 1;
    }

    /* E -> E+E | E*E | E/E */
    if (stack_top >= 2 &&
        stack[stack_top - 2] == 'E' &&
        stack[stack_top] == 'E')
    {
        char operator = stack[stack_top - 1];

        if (operator == '+' || operator == '*' || operator == '/')
        {
            stack_top -= 2;
            stack[stack_top] = 'E';

            char action[20];
            snprintf(action, sizeof(action), "E -> E %c E", operator);
            display(action);
            return 1;
        }
    }

    return 0;
}

int main(void)
{
    printf("SHIFT-REDUCE PARSER\n");
    printf("Grammar:\n");
    printf("E -> E+E | E*E | E/E | a | b\n");
    printf("Enter the input string: ");

    if (scanf("%99s", input) != 1)
        return 1;

    printf("\nStack\t\tInput\t\tAction");
    printf("\n-----\t\t-----\t\t------");
    printf("\n$\t\t%s$\t\t--", input);

    while (input[input_pos] != '\0')
    {
        stack[++stack_top] = input[input_pos++];
        display("Shift");

        while (reduce())
        {
            if (stack_top == 0 &&
                stack[0] == 'E' &&
                input[input_pos] == '\0')
            {
                display("ACCEPT");
                return 0;
            }
        }
    }

    if (stack_top == 0 && stack[0] == 'E')
        display("ACCEPT");
    else
        display("REJECT");

    return 0;
}


