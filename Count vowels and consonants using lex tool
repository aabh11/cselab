
%{
#include <stdio.h>

int vow = 0, con = 0;
%}

%%
[aeiouAEIOU]    { vow++; }
[a-zA-Z]        { con++; }
.|\n            ;
%%

int yywrap()
{
    return 1;
}

int main()
{
    printf("Enter a string:\n");
    yylex();

    printf("Number of vowels = %d\n", vow);
    printf("Number of consonants = %d\n", con);

    return 0;
}


